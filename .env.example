# Configuración de Entorno TradIA
# NOTA: La aplicación NO utiliza ni requiere API keys de trading.
# Toda la consulta de mercado se realiza mediante endpoints públicos de solo lectura.

# Base de Datos en la Nube (Supabase - PostgreSQL)
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_KEY=tu_service_role_o_anon_key

# Notificaciones por Email (Mailjet / SMTP configurable)
MAILJET_API_KEY=tu_api_key_mailjet
MAILJET_SECRET_KEY=tu_secret_key_mailjet
MAILJET_SENDER=tu_correo@gmail.com
MAILJET_TO=tu_correo@gmail.com
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587

# Compatibilidad legacy (Gmail SMTP)
# GMAIL_ADDRESS=tu_correo@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Notificaciones por WhatsApp (Twilio/Meta - Canal alternativo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+34600000000

# Parámetros generales
LOG_LEVEL=INFO
TIMEZONE=Europe/Madrid
